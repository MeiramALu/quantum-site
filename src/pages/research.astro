---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getDirections, getProjects, getResults, getPublications } from '../lib/cms';

const [directions, projects, results, publications] = await Promise.all([getDirections(), getProjects(), getResults(), getPublications()]);
const active = projects.filter((p) => p.status === 'Active & completed');
const review = projects.filter((p) => p.status === 'Under review');

const description =
  'Research at the Quantum AI Laboratory: quantum algorithms for PDEs and oil recovery, variational and hybrid computing, and quantum machine learning — with peer-reviewed results and publications.';
---

<Base title="Research" description={description} active="research">
  <PageHeader
    eyebrow="Research & publications"
    title="Quantum algorithms for real, hard problems."
    lede="We build quantum and hybrid quantum–classical methods and test them from simulators through to real hardware — with results published in peer-reviewed venues."
  />

  <!-- DIRECTIONS IN DEPTH -->
  <section class="section" id="directions">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Directions</p>
        <h2>Three research lines.</h2>
      </div>

      <div class="dirs">
        {directions.map((d, i) => (
          <article class="dirrow" data-color={d.color} data-reveal>
            <div class="dirrow-mark">
              <span class="dirrow-num">0{i + 1}</span>
              <span class="dirrow-swatch" data-color={d.color} aria-hidden="true"></span>
            </div>
            <div class="dirrow-body">
              <h3>{d.title}</h3>
              <p>{d.detail}</p>
              <ul class="tagline">
                {d.tags.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- KEY RESULTS -->
  <section class="section dark results" id="results">
    <div class="container">
      <div class="section-head on-dark" data-reveal>
        <p class="eyebrow on-dark">Selected results</p>
        <h2>What the algorithms actually did.</h2>
        <p>Each result below is drawn from a peer-reviewed paper — follow the DOI for the full method and data.</p>
      </div>

      <div class="res-grid">
        {results.map((r, i) => (
          <article class="res" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="res-metric">
              <span class="res-n">{r.metric}</span>
              <span class="res-nl">{r.metricLabel}</span>
            </div>
            <h3>{r.title}</h3>
            <p>{r.detail}</p>
            <a class="res-doi" href={r.doi} target="_blank" rel="noopener">
              {r.venue} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Grant projects</p>
        <h2>Funded and in-review research.</h2>
        <p>The lab's work is carried by competitively funded scientific projects.</p>
      </div>

      <div class="proj-cols">
        <div class="proj-col" data-reveal>
          <h3 class="proj-status">Active &amp; completed</h3>
          {active.map((p) => (
            <div class="proj">
              <h4>{p.title}</h4>
              <p>{p.scope}</p>
              <span class="proj-fund">{p.funding}</span>
            </div>
          ))}
        </div>
        <div class="proj-col" data-reveal data-reveal-delay="1">
          <h3 class="proj-status muted">Under review</h3>
          {review.map((p) => (
            <div class="proj">
              <h4>{p.title}</h4>
              <p>{p.scope}</p>
              <span class="proj-fund">{p.funding}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLICATIONS -->
  <section class="section pubs-sec" id="publications">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Publications</p>
        <h2>Seven papers, 2023–2026.</h2>
      </div>

      <ol class="pubs">
        {publications.map((p, i) => (
          <li class="pub" data-reveal>
            <span class="pub-idx">{String(i + 1).padStart(2, '0')}</span>
            <div class="pub-body">
              <h3 class="pub-title">{p.title}</h3>
              <p class="pub-meta">{p.authors} · <span class="pub-venue">{p.venue}</span> · {p.year}</p>
            </div>
            <div class="pub-link">
              {p.doi ? (
                <a href={p.doi} target="_blank" rel="noopener">DOI ↗</a>
              ) : (
                <span class="pub-nolink">Preprint</span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* DIRECTIONS */
  .dirs { border-top: 1px solid var(--c-hairline); }
  .dirrow {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--s-xl);
    padding-block: var(--s-xl);
    border-bottom: 1px solid var(--c-hairline);
  }
  .dirrow-mark { display: flex; flex-direction: column; gap: var(--s-base); }
  .dirrow-num {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--c-muted);
    letter-spacing: 0.08em;
  }
  .dirrow-swatch { width: 52px; height: 52px; border: 1px solid var(--c-ink-deep); }
  .dirrow-swatch[data-color='chartreuse'] { background: var(--c-tertiary); }
  .dirrow-swatch[data-color='lavender'] { background: var(--c-lavender); }
  .dirrow-swatch[data-color='mint'] { background: var(--c-mint-soft); }
  .dirrow-body h3 { font-size: clamp(22px, 2.8vw, 30px); letter-spacing: -0.02em; text-wrap: balance; }
  .dirrow-body p {
    margin-top: var(--s-base);
    max-width: 68ch;
    color: var(--c-muted);
    font-size: var(--t-body-lg);
    line-height: 1.6;
  }
  .tagline { margin-top: var(--s-md); display: flex; flex-wrap: wrap; gap: 8px; }
  .tagline li {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 5px 10px;
    border: 1px solid var(--c-hairline);
    color: var(--c-ink);
  }

  /* RESULTS */
  .results { border-block: 1px solid var(--c-ink-deep); }
  .res-grid {
    margin-top: var(--s-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0;
    border: 1px solid var(--c-hairline-dark);
  }
  .res {
    padding: var(--s-lg);
    border-right: 1px solid var(--c-hairline-dark);
    display: flex;
    flex-direction: column;
  }
  .res:last-child { border-right: 0; }
  .res-metric { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--s-md); }
  .res-n {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 58px);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--c-primary);
  }
  .res-nl {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted-dark);
  }
  .res h3 { font-size: 19px; color: #fff; line-height: 1.2; text-wrap: balance; }
  .res p {
    margin-top: 10px;
    color: var(--c-muted-dark);
    font-size: 14.5px;
    line-height: 1.6;
    flex: 1;
  }
  .res-doi {
    margin-top: var(--s-md);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--c-primary);
    padding-top: var(--s-base);
    border-top: 1px solid var(--c-hairline-dark);
  }
  .res-doi:hover { color: #fff; }

  /* PROJECTS */
  .proj-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-xl); }
  .proj-status {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-bottom: var(--s-base);
    border-bottom: 2px solid var(--c-primary);
    margin-bottom: var(--s-md);
    color: var(--c-ink);
  }
  .proj-status.muted { border-bottom-color: var(--c-lavender); }
  .proj {
    padding-block: var(--s-md);
    border-bottom: 1px solid var(--c-hairline);
  }
  .proj h4 { font-size: 18px; line-height: 1.25; letter-spacing: -0.01em; }
  .proj p { margin-top: 8px; color: var(--c-muted); font-size: 14.5px; line-height: 1.55; }
  .proj-fund {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    border: 1px solid var(--c-hairline);
    padding: 4px 8px;
  }

  /* PUBLICATIONS */
  .pubs-sec { background: var(--c-surface-1); border-top: 1px solid var(--c-hairline); }
  .pubs { border-top: 1px solid var(--c-hairline); }
  .pub {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: var(--s-md);
    align-items: center;
    padding-block: var(--s-md);
    border-bottom: 1px solid var(--c-hairline);
  }
  .pub-idx { font-family: var(--f-mono); font-size: 13px; color: var(--c-muted); }
  .pub-title { font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty; }
  .pub-meta { margin-top: 6px; font-size: 13.5px; color: var(--c-muted); line-height: 1.5; }
  .pub-venue { color: var(--c-ink); }
  .pub-link a {
    font-family: var(--f-mono);
    font-size: 12px;
    white-space: nowrap;
    border: 1px solid var(--c-ink);
    padding: 8px 12px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .pub-link a:hover { background: var(--c-ink); color: var(--c-canvas); }
  .pub-nolink {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 760px) {
    .dirrow { grid-template-columns: 1fr; gap: var(--s-base); padding-block: var(--s-lg); }
    .dirrow-mark { flex-direction: row; align-items: center; gap: 14px; }
    .dirrow-swatch { width: 40px; height: 40px; }
    .dirrow-body h3 { font-size: clamp(20px, 5.6vw, 26px); }
    .dirrow-body p { font-size: 15px; margin-top: 12px; }
    .res { border-right: 0; border-bottom: 1px solid var(--c-hairline-dark); padding: var(--s-md); }
    .res:last-child { border-bottom: 0; }
    .res-n { font-size: clamp(34px, 11vw, 46px); }
    .res h3 { font-size: 18px; }
    .res p { font-size: 14px; }
    .proj-cols { grid-template-columns: 1fr; gap: var(--s-lg); }
    .proj h4 { font-size: 16px; }
    .proj p { font-size: 14px; }
    .pub { grid-template-columns: 28px 1fr; gap: var(--s-sm) var(--s-base); padding-block: var(--s-base); }
    .pub-title { font-size: 16px; }
    .pub-meta { font-size: 12.5px; }
    .pub-link { grid-column: 2; justify-self: start; }
  }
</style>
