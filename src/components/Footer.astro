---
import { Image } from 'astro:assets';
import farabi from '../assets/logos/farabi.png';
import spinq from '../assets/logos/spinq-white.png';
const year = 2026;
---

<footer class="footer" id="contact">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-row">
        <Image src={farabi} alt="Al-Farabi Kazakh National University" class="f-logo f-farabi" widths={[64, 128]} sizes="40px" />
        <span class="footer-word">Quantum AI Laboratory</span>
        <Image src={spinq} alt="SpinQ" class="f-logo f-spinq" widths={[64, 128]} sizes="34px" />
      </div>
      <p class="footer-tag">
        The first quantum-computing laboratory in Kazakhstan, building quantum and hybrid
        algorithms for physics, oil recovery, and machine learning.
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h3 class="footer-h">Explore</h3>
      <a href="/">Home</a>
      <a href="/research">Research &amp; publications</a>
      <a href="/media">Media &amp; collaboration</a>
    </nav>

    <div class="footer-col">
      <h3 class="footer-h">Find us</h3>
      <address class="footer-addr">
        Al-Farabi Kazakh National University<br />
        Faculty of Information Technology &amp; Artificial Intelligence<br />
        Al-Farabi Ave 71/23, Mechanics-Mathematics building, room 216<br />
        Almaty, Kazakhstan
      </address>
      <a class="footer-mail" href="mailto:azatbekuly_nurtugan3@live.kaznu.kz?subject=Collaboration%20with%20Quantum%20AI%20Laboratory">
        Get in touch →
      </a>
      <a class="footer-ext" href="https://farabi.university/?lang=en" target="_blank" rel="noopener">
        farabi.university ↗
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Quantum AI Laboratory · Al-Farabi Kazakh National University</span>
    <span class="footer-loc">Almaty · Kazakhstan</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-ink-deep);
    color: var(--c-canvas);
    padding-top: var(--s-2xl);
    border-top: 3px solid var(--c-primary);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.4fr;
    gap: var(--s-xl);
    padding-bottom: var(--s-2xl);
  }
  .brand-row { display: flex; align-items: center; gap: 12px; }
  .f-logo { flex: none; width: auto; object-fit: contain; }
  .f-farabi { height: 40px; }
  .f-spinq { height: 30px; opacity: 0.95; }
  .footer-word {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .footer-tag {
    margin-top: var(--s-base);
    color: var(--c-muted-dark);
    max-width: 42ch;
    line-height: 1.6;
  }
  .footer-h {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-primary);
    margin-bottom: var(--s-base);
  }
  .footer-col { display: flex; flex-direction: column; gap: 12px; }
  .footer-col a { color: var(--c-canvas); width: fit-content; }
  .footer-col a:hover { color: var(--c-primary); }
  .footer-addr {
    font-style: normal;
    color: var(--c-muted-dark);
    line-height: 1.7;
  }
  .footer-mail { color: var(--c-primary) !important; font-weight: 500; }
  .footer-ext { color: var(--c-muted-dark) !important; font-size: 14px; }
  .footer-ext:hover { color: var(--c-primary) !important; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--s-base);
    padding-block: var(--s-md);
    border-top: 1px solid var(--c-hairline-dark);
    font-size: 13px;
    color: var(--c-muted-dark);
  }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--s-xl); }
    .footer-bottom { flex-direction: column; gap: 6px; }
  }
</style>
