---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="pagehead">
  <div class="pagehead-lines" aria-hidden="true"></div>
  <div class="container pagehead-inner">
    <p class="pagehead-eyebrow">{eyebrow}</p>
    <h1 class="pagehead-title">{title}</h1>
    {lede && <p class="pagehead-lede">{lede}</p>}
  </div>
</header>

<style>
  .pagehead {
    position: relative;
    background: var(--c-ink-deep);
    color: var(--c-canvas);
    overflow: hidden;
    isolation: isolate;
  }
  .pagehead-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(122, 147, 126, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(122, 147, 126, 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(100% 80% at 80% 0%, #000, transparent 70%);
  }
  .pagehead-inner {
    padding-block: clamp(72px, 14vh, 150px) clamp(40px, 8vh, 80px);
    max-width: 860px;
  }
  .pagehead-eyebrow {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-primary);
    margin-bottom: var(--s-base);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pagehead-eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--c-primary);
  }
  .pagehead-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(30px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--c-canvas);
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .pagehead-lede {
    margin-top: var(--s-md);
    font-size: clamp(15.5px, 2vw, 20px);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
    max-width: 62ch;
    text-wrap: pretty;
  }
  @media (max-width: 700px) {
    .pagehead-inner { padding-block: clamp(56px, 12vh, 96px) var(--s-lg); }
  }
</style>
