---
import { img, imgSet } from '../lib/cms';

export interface GalleryItem {
  /** id файла в Directus */
  src: string | null;
  alt: string;
  caption?: string;
  /** span two columns on wide screens for rhythm */
  wide?: boolean;
}

interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
---

<div class="gallery">
  {items.map((it) => (
    <figure class:list={['g-item', { wide: it.wide }]}>
      <img
        src={img(it.src, 800)}
        srcset={imgSet(it.src, [480, 800, 1200])}
        alt={it.alt}
        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 40vw"
        loading="lazy"
      />
      {it.caption && <figcaption>{it.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2px;
    background: var(--c-hairline);
    border: 1px solid var(--c-hairline);
  }
  .g-item {
    position: relative;
    margin: 0;
    background: var(--c-ink-deep);
    overflow: hidden;
  }
  .g-item.wide { grid-column: span 2; }
  .g-item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .g-item:hover img { transform: scale(1.04); }
  .g-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 16px 12px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #fff;
    background: linear-gradient(transparent, rgba(8, 9, 12, 0.85));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .g-item:hover figcaption,
  .g-item:focus-within figcaption { opacity: 1; transform: none; }

  @media (max-width: 700px) {
    .g-item.wide { grid-column: auto; }
    .g-item figcaption { opacity: 1; transform: none; } /* no hover on touch */
  }
</style>
